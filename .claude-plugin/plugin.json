{
  "name": "aegis",
  "version": "0.1.0",
  "description": "LLM-classifier-driven permission mode for Claude Code",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/orchestrator.sh" }
        ]
      }
    ]
  },
  "commands": ["commands/aegis-on.md", "commands/aegis-off.md", "commands/aegis-status.md"]
}
